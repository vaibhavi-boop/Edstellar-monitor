# ─────────────────────────────────────────────────────────────
# Edstellar Monitor — environment variables
# Copy to .env (local) and set the same keys in Vercel / your worker host.
# Never commit real values. Generate secrets with:  openssl rand -base64 48
# ─────────────────────────────────────────────────────────────

# ── Phase 1: required ────────────────────────────────────────
# Pooled connection string used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/edstellar_monitor?sslmode=require"
# Direct (non-pooled) connection for `prisma migrate`. Optional when your
# provider gives you a single connection string.
DIRECT_URL=""

# Signs session cookies. At least 32 characters.
AUTH_SECRET=""
# Session lifetime in hours (default 12).
SESSION_TTL_HOURS="12"

# Public base URL of the dashboard (no trailing slash).
APP_URL="http://localhost:3000"

# 32-byte key, base64-encoded, for AES-256-GCM encryption of stored secrets
# (API credentials, Slack webhooks). Generate: openssl rand -base64 32
ENCRYPTION_KEY=""

# First administrator, created by `npm run db:seed` if no admin exists.
SEED_ADMIN_EMAIL="admin@edstellar.com"
SEED_ADMIN_NAME="Administrator"
# At least 12 characters. Remove from the environment after seeding.
SEED_ADMIN_PASSWORD=""

# ── Phase 5: scheduling (not used yet) ──────────────────────
# Shared secret the external scheduler sends as `Authorization: Bearer <token>`.
CRON_SECRET=""

# ── Phase 4: optional integrations (not used yet) ───────────
PAGESPEED_API_KEY=""

# ── Phase 5: email notifications (not used yet) ─────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
NOTIFY_FROM_EMAIL="monitor@edstellar.com"
